# 环境变量配置示例
# 复制此文件为 .env 并填写实际配置值

# ================================
# 数据库配置（必填）
# ================================

# 本地 PostgreSQL 数据库
# 请根据您的实际配置修改
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/job_ai_dev"

# 配置说明:
# - postgres: 数据库用户名（默认通常是 postgres）
# - your_password: 您的 PostgreSQL 密码（必填）
# - localhost: 数据库服务器地址
# - 5432: PostgreSQL 默认端口
# - job_ai_dev: 数据库名称（需要先创建）

# 其他常见配置:
# DATABASE_URL="postgresql://user:password@127.0.0.1:5432/job_ai_dev"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/job_ai"

# ================================
# JWT 配置（必填）
# ================================

JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# 安全提示:
# - 生产环境请使用强随机字符串
# - 可以使用命令生成: openssl rand -base64 32

# ================================
# 服务器配置（可选）
# ================================

# 服务器端口
PORT=8080

# 运行环境
NODE_ENV="development"

# 日志级别 (debug, info, warn, error)
LOG_LEVEL="debug"

# ================================
# CORS 配置（可选）
# ================================

# 允许的前端源（逗号分隔）
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"

# 生产环境可以添加:
# CORS_ORIGIN="https://your-domain.com,https://www.your-domain.com"

# ================================
# AI 服务配置（可选）
# ================================

# DeepSeek API Key
DEEPSEEK_API_KEY="sk-your-deepseek-api-key"

# ================================
# 数据库初始化说明
# ================================

# 首次使用前，请执行以下步骤:

# 1. 创建数据库
#    psql -U postgres -c "CREATE DATABASE job_ai_dev;"

# 2. 初始化数据库结构
#    cd backend
#    pnpm prisma generate
#    pnpm prisma db push

# 3. 可选：填充测试数据
#    pnpm prisma seed

# 4. 启动后端服务
#    pnpm dev

# ================================
# 生产环境部署说明
# ================================

# 部署到生产环境时:
# 1. 修改 DATABASE_URL 为生产数据库地址
# 2. 修改 JWT_SECRET 为强随机字符串
# 3. 设置 NODE_ENV="production"
# 4. 调整 CORS_ORIGIN 为实际域名
# 5. 使用环境变量管理敏感信息（不要提交到 Git）
