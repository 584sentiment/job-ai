# Docker 忽略文件
# 减少构建上下文大小，加快构建速度

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# package-lock.json - 保留用于 Docker 构建
yarn.lock

# 构建产物
dist/
build/

# 环境变量
.env
.env.*
!.env.example

# 日志
logs/
*.log

# IDE
.idea/
.vscode/
*.swp
*.swo

# Git
.git/
.gitignore

# 文档
docs/
README.md
*.md

# 测试
coverage/
.nyc_output/

# 其他
.DS_Store
*.bak
*.tmp
