{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/backend/api/index.ts"
    },
    {
      "source": "/:path*",
      "destination": "/web/dist/index.html"
    }
  ],
  "buildCommand": "cd backend && npm run build && cd ../web && npm run build",
  "outputDirectory": "web/dist"
}
